<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the production calculation sources without activating WinRT/COM. -->
    <Compile Include="..\..\src\ValueGenerator\Generators\**\*.cs" Link="Generators\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\ValueGenerator\InputParser.cs" Link="InputParser.cs" />
    <Compile Include="..\..\src\ValueGenerator\IComputeRequest.cs" Link="IComputeRequest.cs" />
    <Compile Include="..\..\src\ValueGenerator\GeneratorData.cs" Link="GeneratorData.cs" />
    <Compile Include="..\..\src\ValueGenerator\Helpers\NativeMethods.cs" Link="Helpers\NativeMethods.cs" />
    <Compile Include="..\..\src\ValueGenerator\Helpers\CommandCatalog.cs" Link="Helpers\CommandCatalog.cs" />
    <Compile Include="..\..\src\ValueGenerator\Helpers\GeneratorStrings.cs" Link="Helpers\GeneratorStrings.cs" />
  </ItemGroup>
</Project>
